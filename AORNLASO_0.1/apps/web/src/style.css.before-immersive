@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap');
:root{font-family:'IBM Plex Sans Arabic',system-ui,sans-serif;color:#f4f0e7;background:#070910;font-synthesis:none;text-rendering:optimizeLegibility}
*{box-sizing:border-box}body{margin:0;min-width:320px;background:radial-gradient(ellipse at 50% 0%,#1c2035 0,#0b0e18 45%,#070910 100%);min-height:100vh}
#app{max-width:1120px;margin:auto;padding:0 22px}.topbar{height:78px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff16}
.brand{display:flex;align-items:center;gap:12px}.brand-mark{color:#d8b66a;font-size:30px}.brand strong{display:block;letter-spacing:3px;font-size:16px}.brand small{display:block;color:#9295a5;font-size:11px}
.connection{font-size:12px;color:#aeb2c0;display:flex;align-items:center;gap:8px}#connection-dot{width:8px;height:8px;border-radius:50%;background:#777}#connection-dot.online{background:#5ed39b;box-shadow:0 0 12px #5ed39b}
main{padding:46px 0}.hero{text-align:center;padding:22px 0 38px}.eyebrow{color:#d6b66e;font-size:11px;letter-spacing:1.5px}.hero h1{font-size:clamp(34px,7vw,66px);line-height:1.2;margin:12px 0}.hero h1 em{font-style:normal;color:#d6b66e}.hero p{color:#a3a7b6;margin:0 0 24px;font-size:14px}
.join-panel{display:flex;gap:8px;max-width:420px;margin:auto}.join-panel input{flex:1;min-width:0;background:#121624;border:1px solid #34394c;color:white;padding:13px 15px;border-radius:9px;font:inherit}.join-panel button{background:#d6b66e;color:#17130a;border:0;border-radius:9px;padding:0 20px;font:600 13px 'IBM Plex Sans Arabic',sans-serif;cursor:pointer}.join-panel button:disabled{opacity:.5}.status-line{color:#858b9d;font-size:11px;margin-top:12px}
.world-panel,.players-panel{border:1px solid #ffffff1c;background:#101421c9;border-radius:15px;padding:20px;margin:16px 0}.panel-heading{display:flex;align-items:center;justify-content:space-between}.panel-heading h2{font-size:18px;margin:3px 0 14px}.live-tag{font-size:10px;color:#70d9a6}
#scene{height:340px;border-radius:10px;overflow:hidden;background:radial-gradient(ellipse at center,#1b2340,#080b15 70%)}#scene canvas{display:block;width:100%;height:100%}.controls-hint{text-align:center;color:#81889a;font-size:11px;margin:13px 0 8px}
.move-controls{display:flex;flex-direction:column;align-items:center;gap:5px}.move-controls div{display:flex;gap:5px}.move-controls button{width:43px;height:36px;border-radius:8px;border:1px solid #55516a;background:#191e2d;color:#e8d4a1;font-size:18px;cursor:pointer;touch-action:manipulation}
#player-count{color:#d6b66e;font-size:22px}.players-list{display:flex;flex-wrap:wrap;gap:8px;min-height:35px}.player-chip{padding:7px 11px;background:#1a2030;border:1px solid #34394b;border-radius:20px;font-size:12px}.empty{color:#777f91;font-size:12px}.system-log{border-top:1px solid #ffffff12;padding-top:10px;margin-top:12px;color:#8f96a8;font-size:11px;min-height:28px}
footer{text-align:center;color:#666d7e;font-size:10px;padding:22px;border-top:1px solid #ffffff12}
@media(max-width:520px){#app{padding:0 13px}.topbar{height:66px}.hero{padding-top:28px}.world-panel,.players-panel{padding:14px}#scene{height:270px}.join-panel button{padding:0 12px}}
